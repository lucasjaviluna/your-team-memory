{
  "compilerOptions": {
    "target":          "ES2022",
    "module":          "NodeNext",
    "moduleResolution":"NodeNext",
    "jsx":             "react-jsx",
    "strict":          false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "outDir":          "dist",
    "rootDir":         "src",
    "skipLibCheck":    true,
    "lib":             ["ES2022"]
  },
  "include": ["src"]
}
